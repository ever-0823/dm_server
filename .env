#用于安全地存储环境变量，将配置与代码分离
APP_NAME=Practice Server
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=1234
DB_NAME=practice_db

# pgvector 独立保存知识文档和文本向量。
VECTOR_DB_HOST=127.0.0.1
VECTOR_DB_PORT=5432
VECTOR_DB_NAME=knowledge_db
VECTOR_DB_USER=postgres
VECTOR_DB_PASSWORD=1234

# 第一阶段使用本地 Qwen3-Embedding-0.6B 和 1024 维向量。
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-0.6B
# 国内网络默认从 ModelScope 下载，设为 huggingface 可切回 Hugging Face。
EMBEDDING_MODEL_SOURCE=modelscope
EMBEDDING_DEVICE=cpu
EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_CHUNK_SIZE=600
KNOWLEDGE_CHUNK_OVERLAP=80
